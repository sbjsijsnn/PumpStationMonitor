<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    x:Class="PumpStationMonitor.App.Views.Pages.HistoryPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="历史查询" Style="{StaticResource Title}" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <WrapPanel Margin="0,0,0,14">
                <TextBlock Text="从" Margin="0,0,8,0" />
                <TextBox Width="175" Text="{Binding TimeRange.FromText}" />
                <TextBlock Text="至" Margin="12,0,8,0" />
                <TextBox Width="175" Text="{Binding TimeRange.ToText}" />
                <TextBlock Text="yyyy-MM-dd HH:mm:ss" Foreground="#637987" Margin="12,0,0,0" />
            </WrapPanel>
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,14">
            <ComboBox
                ItemsSource="{Binding DeviceOptions}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding HistoryDevice}"
                Width="150"
                Margin="0,0,12,0" />
            <ComboBox
                ItemsSource="{Binding Tags}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding HistoryTag}"
                Width="225"
                Margin="0,0,12,0" />
            <Button Content="查询与回放" Command="{Binding QueryHistoryCommand}" />
        </WrapPanel>
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,0,14">
            <lvc:CartesianChart
                Series="{Binding HistorySeries}"
                XAxes="{Binding TimeAxes}"
                YAxes="{Binding ValueAxes}"
                AnimationsSpeed="0:0:0" />
        </Border>
        <DataGrid ItemsSource="{Binding HistoryRows}" Grid.Row="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="采样时间" Binding="{Binding TimeText}" Width="230" />
                <DataGridTextColumn Header="点位" Binding="{Binding TagId}" Width="*" />
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="120" />
                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <DockPanel>
                <Button Content="{Binding ReplayButton}" Command="{Binding ToggleReplayCommand}" />
                <TextBlock Text="{Binding ReplayTime}" Width="190" />
                <Slider
                    Minimum="0"
                    Maximum="{Binding HistoryRows.Count}"
                    Value="{Binding ReplayPosition}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding QuerySummary}" Margin="0,8,0,0" Foreground="#637987" />
        </StackPanel>
    </Grid>
</UserControl>
