<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" x:Class="PumpStationMonitor.App.Views.MainWindow" Title="泵站设备监控" Width="1360" Height="920" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen">
    <Grid Background="#F1F5F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="#173E53">
            <DockPanel Margin="22,30,22,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="泵站设备监控" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="本地工作站" Foreground="#A6C3CF" Margin="0,8,0,30"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding UserLabel}" Foreground="#C5DCE4" TextWrapping="Wrap"/>
                    <TextBlock Text="设备采集与运行记录" Foreground="#86ABBC" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Page}" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,14"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Foreground" Value="#DCE9EE"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavBorder" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavBorder" Property="Background" Value="#2B6077"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavBorder" Property="Background" Value="#28556A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="#DFE8ED" BorderThickness="0,0,0,1" Padding="28,0">
            <DockPanel>
                <TextBlock Text="运行监测 / 小型泵站" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionColor}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Connection}" Foreground="{Binding ConnectionColor}"/>
                </StackPanel>
                <TextBlock Text="{Binding Clock}" HorizontalAlignment="Right" Foreground="#637987"/>
            </DockPanel>
        </Border>
        <TabControl Grid.Column="1" Grid.Row="1" SelectedIndex="{Binding Page}" Margin="28,24,16,20" Background="Transparent" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="站点总览" Style="{StaticResource Title}"/>
                        <TextBlock Text="掌握设备工况，及时响应异常。" Style="{StaticResource Caption}"/>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding AlarmSummary}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PollLabel}" Foreground="#637987" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding ConnectionColor}" Width="10" Height="10" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Connection}" FontSize="16"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,14,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#637987" Margin="0,4,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Primary}" FontSize="32" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PrimaryUnit}" Margin="10,12,0,0" Foreground="#637987"/>
                                            </StackPanel>
                                            <ProgressBar Value="{Binding Gauge}" Maximum="100" Height="5" Margin="0,8,0,8" Foreground="{Binding Color}"/>
                                            <TextBlock Text="{Binding Secondary}" Foreground="#637987"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Panel}" Margin="0,4,14,0">
                            <StackPanel>
                                <TextBlock Text="机组控制" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="操作员仅可查看；控制应答后请核对设备状态。" Foreground="#637987" Margin="0,6,0,16"/>
                                <WrapPanel IsEnabled="{Binding IsAdmin}">
                                    <ComboBox ToolTip="Coil：写单线圈；Register：写单寄存器" ItemsSource="{Binding ControlModes}" SelectedItem="{Binding ControlMode}" Width="115" Margin="0,0,14,0"/>
                                    <Button Content="启动 1# 泵" Command="{Binding ControlCommand}" CommandParameter="1:start"/>
                                    <Button Content="停止 1# 泵" Command="{Binding ControlCommand}" CommandParameter="1:stop"/>
                                    <Button Content="启动 2# 泵" Command="{Binding ControlCommand}" CommandParameter="2:start"/>
                                    <Button Content="停止 2# 泵" Command="{Binding ControlCommand}" CommandParameter="2:stop"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="实时数据" Style="{StaticResource Title}"/>
                    <TextBlock Grid.Row="1" Text="零基地址 · 无效或过期数据不显示为正常值" Style="{StaticResource Caption}"/>
                    <DataGrid ItemsSource="{Binding LiveRows}" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="120"/>
                            <DataGridTextColumn Header="点位名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding ValueText}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="90"/>
                            <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="90"/>
                            <DataGridTextColumn Header="更新时间" Binding="{Binding Updated}" Width="110"/>
                            <DataGridTextColumn Header="功能 / 地址 / 位" Binding="{Binding Address}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="运行趋势" Style="{StaticResource Title}"/>
                    <WrapPanel Grid.Row="1" Margin="0,16,0,22">
                        <TextBlock Text="监测点位" Margin="0,0,10,0"/>
                        <ComboBox Width="225" ItemsSource="{Binding Tags}" DisplayMemberPath="Name" SelectedItem="{Binding TrendTag}"/>
                        <TextBlock Text="窗口" Margin="22,0,10,0"/>
                        <ComboBox Width="100" ItemsSource="{Binding Spans}" SelectedItem="{Binding SpanMinutes}"/>
                        <TextBlock Text="分钟" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource Panel}">
                        <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding ValueAxes}" AnimationsSpeed="0:0:0"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="缓存最近 60 分钟；无效质量形成曲线断点。重启后可在历史查询页查看已存记录。" Margin="0,16,0,0" Foreground="#637987"/>
                </Grid>
            </TabItem>
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="报警中心" Style="{StaticResource Title}"/>
                    <TabControl x:Name="AlarmTabs" Grid.Row="1" Margin="0,16,0,0">
                        <TabItem Header="当前报警">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <Button Content="确认选中报警" Command="{Binding AcknowledgeCommand}"/>
                                    <TextBlock Text="{Binding AlarmSummary}"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding ActiveAlarms}" Grid.Row="1" SelectedItem="{Binding SelectedAlarm}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="发生时间" Binding="{Binding RaisedText}" Width="140"/>
                                        <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="70"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="155"/>
                                        <DataGridTextColumn Header="触发值" Binding="{Binding Value}" Width="75"/>
                                        <DataGridTextColumn Header="确认人" Binding="{Binding AcknowledgedBy}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="报警历史">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,14">
                                    <TextBlock Text="从" Margin="0,0,8,0"/>
                                    <TextBox Width="175" Text="{Binding FromText}"/>
                                    <TextBlock Text="至" Margin="12,0,8,0"/>
                                    <TextBox Width="175" Text="{Binding ToText}"/>
                                    <TextBlock Text="yyyy-MM-dd HH:mm:ss" Foreground="#637987" Margin="12,0,0,0"/>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                                    <Button Content="查询" Command="{Binding QueryAlarmsCommand}"/>
                                    <Button Content="导出 CSV" Command="{Binding ExportAlarmsCommand}"/>
                                    <Button Content="确认选中记录" Command="{Binding AcknowledgeHistoryCommand}"/>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding AlarmHistory}" Grid.Row="2" SelectedItem="{Binding SelectedHistoricalAlarm}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="发生时间" Binding="{Binding RaisedText}" Width="140"/>
                                        <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="70"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="155"/>
                                        <DataGridTextColumn Header="触发值" Binding="{Binding Value}" Width="75"/>
                                        <DataGridTextColumn Header="确认人" Binding="{Binding AcknowledgedBy}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="历史查询" Style="{StaticResource Title}"/>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <WrapPanel Margin="0,0,0,14">
                            <TextBlock Text="从" Margin="0,0,8,0"/>
                            <TextBox Width="175" Text="{Binding FromText}"/>
                            <TextBlock Text="至" Margin="12,0,8,0"/>
                            <TextBox Width="175" Text="{Binding ToText}"/>
                            <TextBlock Text="yyyy-MM-dd HH:mm:ss" Foreground="#637987" Margin="12,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,14">
                        <ComboBox ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="Name" SelectedItem="{Binding HistoryDevice}" Width="150" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Tags}" DisplayMemberPath="Name" SelectedItem="{Binding HistoryTag}" Width="225" Margin="0,0,12,0"/>
                        <Button Content="查询与回放" Command="{Binding QueryHistoryCommand}"/>
                    </WrapPanel>
                    <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,0,14">
                        <lvc:CartesianChart Series="{Binding HistorySeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding ValueAxes}" AnimationsSpeed="0:0:0"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding HistoryRows}" Grid.Row="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="采样时间" Binding="{Binding TimeText}" Width="230"/>
                            <DataGridTextColumn Header="点位" Binding="{Binding TagId}" Width="*"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="5" Margin="0,12,0,0">
                        <DockPanel>
                            <Button Content="{Binding ReplayButton}" Command="{Binding ToggleReplayCommand}"/>
                            <TextBlock Text="{Binding ReplayTime}" Width="190"/>
                            <Slider Minimum="0" Maximum="{Binding HistoryRows.Count}" Value="{Binding ReplayPosition}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding QuerySummary}" Margin="0,8,0,0" Foreground="#637987"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="系统设置" Style="{StaticResource Title}"/>
                    <TextBlock Grid.Row="1" Text="仅管理员可修改配置和用户。已有活动报警的点位与规则暂不能修改。" Style="{StaticResource Caption}"/>
                    <TabControl x:Name="SettingsTabs" Grid.Row="2" IsEnabled="{Binding IsAdmin}">
                        <TabItem Header="通信与存储">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="保存后自动重新连接；数据库中的设置优先于首次启动配置。" Style="{StaticResource Caption}"/>
                                    <WrapPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="协议" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Modes}" SelectedValue="{Binding Communication.Mode}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="TCP 主机" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.Host,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="TCP 端口" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.Port,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="串口名称" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.SerialPort,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="波特率" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.BaudRate,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="数据位（5–8）" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.DataBits,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="校验（None/Odd/Even）" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.Parity,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="停止位（One/Two）" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.StopBits,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="采集周期 / ms" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.PollIntervalMs,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="超时 / ms" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.TimeoutMs,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="读取重试次数" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.Retries,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="历史保留 / 天" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Communication.RetentionDays,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Button Content="保存通信与保留设置" Command="{Binding SaveCommunicationCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="点表管理">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <DataGrid ItemsSource="{Binding Tags}" Height="195" SelectedItem="{Binding SelectedTag}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="标识" Binding="{Binding Id}" Width="170"/>
                                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="70"/>
                                            <DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="选择一行编辑，或新增点位。删除保留已采集历史。" Margin="0,16,0,16" Foreground="#637987"/>
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="标识（不可与其他点位重复）" Margin="0,0,0,6"/>
                                                <TextBox IsReadOnly="{Binding IsEditingTag}" Text="{Binding TagEditor.Id,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="点位名称" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Name,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="设备" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding StationDevices}" SelectedValue="{Binding TagEditor.DeviceId}" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="功能码（01/02/03/04）" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Function,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="地址（零基）" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Address,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="单位" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Unit,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="比例" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Scale,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="偏移" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Offset,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="位（留空=模拟量）" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding TagEditor.Bit,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="数据类型" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding Types}" SelectedValue="{Binding TagEditor.DataType}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,16,16">
                                                <TextBlock Text="字节序" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding Orders}" SelectedValue="{Binding TagEditor.ByteOrder}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <CheckBox Content="启用采集" IsChecked="{Binding TagEditor.Enabled}" Margin="0,0,0,16"/>
                                        <WrapPanel>
                                            <Button Content="新增点位" Command="{Binding NewTagCommand}"/>
                                            <Button Content="保存点位" Command="{Binding SaveTagCommand}"/>
                                            <Button Content="删除选中点位" Command="{Binding DeleteTagCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="报警规则">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <DataGrid ItemsSource="{Binding Rules}" Height="195" SelectedItem="{Binding SelectedRule}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="标识" Binding="{Binding Id}" Width="150"/>
                                            <DataGridTextColumn Header="点位" Binding="{Binding TagId}" Width="*"/>
                                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70"/>
                                            <DataGridTextColumn Header="限值" Binding="{Binding LimitValue}" Width="70"/>
                                            <DataGridTextColumn Header="死区" Binding="{Binding Deadband}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,20,0,0">
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="规则标识" Margin="0,0,0,6"/>
                                            <TextBox IsReadOnly="{Binding IsEditingRule}" Text="{Binding RuleEditor.Id,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="点位" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Tags}" SelectedValue="{Binding RuleEditor.TagId}" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="类型" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding RuleEditor.Kind}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="限值" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding RuleEditor.LimitValue,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="死区" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding RuleEditor.Deadband,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="延时 / ms" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding RuleEditor.DelayMs,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,16,16">
                                            <TextBlock Text="级别" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Severities}" SelectedValue="{Binding RuleEditor.Severity}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox Content="启用规则" IsChecked="{Binding RuleEditor.Enabled}" Margin="0,0,0,16"/>
                                    <WrapPanel>
                                        <Button Content="新增规则" Command="{Binding NewRuleCommand}"/>
                                        <Button Content="保存规则" Command="{Binding SaveRuleCommand}"/>
                                        <Button Content="删除选中规则" Command="{Binding DeleteRuleCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="用户管理">
                            <StackPanel Margin="20">
                                <DataGrid ItemsSource="{Binding Users}" Height="200" SelectedItem="{Binding SelectedUser}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="*"/>
                                        <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="150"/>
                                        <DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,20,0,0">
                                    <StackPanel Width="190" Margin="0,0,16,16">
                                        <TextBlock Text="用户名" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding EditUsername,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                                    </StackPanel>
                                    <StackPanel Width="190" Margin="0,0,16,16">
                                        <TextBlock Text="角色" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding EditRole}"/>
                                    </StackPanel>
                                    <StackPanel Width="200">
                                        <TextBlock Text="新密码（留空保留原密码）" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="UserPassword" Height="34" Padding="8"/>
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox Content="启用账号" IsChecked="{Binding EditEnabled}" Margin="0,0,0,20"/>
                                <WrapPanel>
                                    <Button Content="新增用户" Command="{Binding NewUserCommand}"/>
                                    <Button Content="保存用户" Click="SaveUserClick"/>
                                    <Button Content="删除选中用户" Command="{Binding DeleteUserCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="Admin 为管理员，Operator 为操作员；密码至少 8 位。" Foreground="#637987" Margin="0,20,0,0"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Column="1" Grid.Row="2" Background="White" BorderBrush="#DFE8ED" BorderThickness="0,1,0,0" Padding="28,0">
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
        </Border>
    </Grid>
</Window>
