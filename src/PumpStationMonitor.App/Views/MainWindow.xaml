<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:pages="clr-namespace:PumpStationMonitor.App.Views.Pages"
    x:Class="PumpStationMonitor.App.Views.MainWindow"
    x:Name="Root"
    Title="泵站设备监控"
    Width="1360"
    Height="920"
    MinWidth="1080"
    MinHeight="720"
    WindowStartupLocation="CenterScreen">
    <Grid Background="#F1F5F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="#173E53">
            <DockPanel Margin="22,30,22,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="泵站设备监控" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="本地工作站" Foreground="#A6C3CF" Margin="0,8,0,30" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock
                        Text="{Binding Workspace.UserLabel, ElementName=Root}"
                        Foreground="#C5DCE4"
                        TextWrapping="Wrap" />
                    <TextBlock Text="设备采集与运行记录" Foreground="#86ABBC" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
                <ListBox
                    ItemsSource="{Binding Navigation}"
                    SelectedIndex="{Binding Page}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,14" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Foreground" Value="#DCE9EE" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavBorder" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavBorder" Property="Background" Value="#2B6077" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavBorder" Property="Background" Value="#28556A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="#DFE8ED" BorderThickness="0,0,0,1" Padding="28,0">
            <DockPanel>
                <TextBlock Text="运行监测 / 小型泵站" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Connection}" Foreground="{Binding ConnectionColor}" />
                </StackPanel>
                <TextBlock Text="{Binding Clock}" HorizontalAlignment="Right" Foreground="#637987" />
            </DockPanel>
        </Border>
        <TabControl
            Grid.Column="1"
            Grid.Row="1"
            SelectedIndex="{Binding Page}"
            Margin="28,24,16,20"
            Background="Transparent"
            BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem>
                <pages:OverviewPage x:Name="OverviewView" />
            </TabItem>
            <TabItem>
                <pages:RealtimePage x:Name="RealtimeView" />
            </TabItem>
            <TabItem>
                <pages:TrendPage x:Name="TrendView" />
            </TabItem>
            <TabItem>
                <pages:AlarmsPage x:Name="AlarmsView" />
            </TabItem>
            <TabItem>
                <pages:HistoryPage x:Name="HistoryView" />
            </TabItem>
            <TabItem>
                <pages:SettingsPage x:Name="SettingsView" />
            </TabItem>
        </TabControl>
        <Border
            Grid.Column="1"
            Grid.Row="2"
            Background="White"
            BorderBrush="#DFE8ED"
            BorderThickness="0,1,0,0"
            Padding="28,0">
            <TextBlock
                Text="{Binding Workspace.Status, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Workspace.Status, ElementName=Root}" />
        </Border>
    </Grid>
</Window>
