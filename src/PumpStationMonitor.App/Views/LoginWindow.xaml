<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PumpStationMonitor.App.Views.LoginWindow" Title="泵站监控 · 登录" Width="780" Height="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Background="#F1F5F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#173E53" Padding="36">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="泵站设备监控" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="让每一轮采集都有记录" Foreground="#B5D4DF" Margin="0,14,0,40"/>
                <Path Stroke="#6AB7C4" StrokeThickness="4" Data="M 0,50 L 35,50 35,10 85,10 85,50 135,50 135,80 205,80"/>
                <TextBlock Text="两台水泵 · 一座集水池&#10;一条出水管路" Foreground="#B5D4DF" Margin="0,36,0,0" LineHeight="25"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="42" VerticalAlignment="Center">
            <TextBlock Text="登录工作站" Style="{StaticResource Title}"/>
            <TextBlock Text="使用站点账号进入监控台" Style="{StaticResource Caption}"/>
            <TextBlock Text="用户名" Margin="0,12,0,6"/>
            <TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Username"/>
            <TextBlock Text="密码" Margin="0,18,0,6"/>
            <PasswordBox x:Name="Password" Height="36" Padding="8" AutomationProperties.AutomationId="Password"/>
            <Button Content="登录" Click="LoginClick" IsDefault="True" Background="#147D92" Foreground="White" Margin="0,24,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding Error}" Foreground="#BB443B" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
